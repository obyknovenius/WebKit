{
	"name": "Arch Linux 2026.09.27",
	"build": {
		"dockerfile": "Containerfile"
	},
	"features": {
        "ghcr.io/obyknovenius/devcontainer-features/add-user:1": {}
    },
	"runArgs": [
		"--device=/dev/dri",
		"--hostname=archlinux"
	],
	"mounts": [
		"type=bind,bind-propagation=rslave,source=${localEnv:XDG_RUNTIME_DIR},target=${localEnv:XDG_RUNTIME_DIR}"
	],
	"capAdd": [
		"SYS_ADMIN",
		"SYS_PTRACE"
	],
	"securityOpt": [
		"seccomp=unconfined",
		"unmask=ALL",
		"label=disable"
	],
	"containerEnv": {
		"WEBKIT_JHBUILD": "TRUE",
		"WEBKIT_OUTPUTDIR": "${containerWorkspaceFolder}/WebKitBuild-archlinux"
	},
	"remoteEnv": {
		"XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
		"DISPLAY": "${localEnv:DISPLAY}",
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
		"PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/Tools/Scripts"
	},
	"remoteUser": "${localEnv:USER}",
	"onCreateCommand": "sudo pacman -Syu --noconfirm && Tools/wpe/install-dependencies && Tools/gtk/install-dependencies && Tools/Scripts/update-webkitwpe-libs && Tools/Scripts/update-webkitgtk-libs",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cpp-devtools",
				"ms-vscode.cmake-tools",
				"Anthropic.claude-code"
			]
		}
	}

}
